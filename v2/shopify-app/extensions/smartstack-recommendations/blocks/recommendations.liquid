{% comment %}
  SmartStack v2 app block, for OS 2.0 product pages.
  Backend app proxy endpoint must be deployed and validated before merchants enable this.
  Uses safe DOM rendering in assets; does not create bundle discounts.
{% endcomment %}
{% if product %}
  <div
    class="smartstack-recommendations"
    data-smartstack-block
    data-product-id="{{ product.id }}"
    data-block-kind="{{ block.settings.recommendation_type }}"
    data-max-items="{{ block.settings.max_items }}"
    data-proxy-path="{{ block.settings.proxy_path | escape }}"
    data-heading="{{ block.settings.heading | escape }}"
    style="--ss-accent: {{ block.settings.accent_colour }}; --ss-radius: {{ block.settings.card_radius }}px"
    {{ block.shopify_attributes }}
    hidden
  >
    <div class="smartstack-recommendations__head">
      <h2 class="smartstack-recommendations__title"></h2>
    </div>
    <div class="smartstack-recommendations__grid" aria-live="polite"></div>
    <p class="smartstack-recommendations__error" role="status" hidden></p>
  </div>
{% endif %}
{% schema %}
{
  "name": "Smart recommendations",
  "target": "section",
  "stylesheet": "smartstack.css",
  "javascript": "smartstack.js",
  "settings": [
    {"type":"select","id":"recommendation_type","label":"Block type","options":[
      {"value":"similar","label":"Similar products"},
      {"value":"complement","label":"Complementary products"},
      {"value":"bought_together","label":"Frequently bought together"},
      {"value":"bundle","label":"Bundle & save"}
    ],"default":"complement"},
    {"type":"text","id":"heading","label":"Optional heading","default":"Pairs perfectly with"},
    {"type":"range","id":"max_items","label":"Maximum add-ons","min":1,"max":8,"step":1,"default":3},
    {"type":"color","id":"accent_colour","label":"Accent colour","default":"#6753dc"},
    {"type":"range","id":"card_radius","label":"Card corner radius","min":0,"max":24,"step":1,"unit":"px","default":10},
    {"type":"text","id":"proxy_path","label":"App proxy root path","default":"/apps/smartstack"}
  ]
}
{% endschema %}
