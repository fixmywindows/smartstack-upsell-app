generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
  @@index([shop])
}

model MerchantShop {
  domain          String   @id
  cursor          String?
  syncFinished    Boolean  @default(false)
  productCount    Int      @default(0)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  products        ProductSnapshot[]
  variants        ProductVariantSnapshot[]
  observedOrders  OrderPairObservation[]
  pairCounts      ObservedProductPair[]
  orderSync       OrderSyncState?
  blocks          RecommendationBlock[]
  ruleSets        RecommendationRuleSet[]
  designs          RecommendationDesign[]
  plan            String   @default("free")
}

model ProductSnapshot {
  shopDomain      String
  productId       String
  title           String
  handle          String
  category        String   @default("")
  productType     String   @default("")
  vendor          String   @default("")
  tags            Json
  collections     Json
  metafields      Json
  variantId       String?
  variantsComplete Boolean @default(true)
  imageUrl        String?
  priceMinor      Int      @default(0)
  currencyCode    String   @default("GBP")
  available       Boolean  @default(false)
  published       Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  shop            MerchantShop @relation(fields: [shopDomain], references: [domain], onDelete: Cascade)
  @@id([shopDomain, productId])
  @@index([shopDomain, category])
}


model ProductVariantSnapshot {
  shopDomain     String
  productId      String
  variantId      String
  title          String
  sku            String?
  priceMinor     Int
  compareAtMinor Int?
  available      Boolean @default(false)
  inventoryQty   Int?
  options        Json @default("[]")
  imageUrl       String?
  updatedAt      DateTime @updatedAt
  shop           MerchantShop @relation(fields: [shopDomain], references: [domain], onDelete: Cascade)
  @@id([shopDomain, variantId])
  @@index([shopDomain, productId])
}

model OrderPairObservation {
  shopDomain String
  orderKey   String
  productIds Json @default("[]")
  placedAt   DateTime
  updatedAt  DateTime @updatedAt
  shop       MerchantShop @relation(fields: [shopDomain], references: [domain], onDelete: Cascade)
  @@id([shopDomain, orderKey])
  @@index([shopDomain, placedAt])
}

model ObservedProductPair {
  shopDomain String
  productA   String
  productB   String
  orderCount Int @default(0)
  updatedAt  DateTime @updatedAt
  shop       MerchantShop @relation(fields: [shopDomain], references: [domain], onDelete: Cascade)
  @@id([shopDomain, productA, productB])
  @@index([shopDomain, productB])
}

model OrderSyncState {
  shopDomain String @id
  cursor     String?
  finished   Boolean @default(false)
  scanned    Int @default(0)
  observed   Int @default(0)
  updatedAt  DateTime @updatedAt
  shop       MerchantShop @relation(fields: [shopDomain], references: [domain], onDelete: Cascade)
}


model RecommendationBlock {
  id              String @id @default(cuid())
  shopDomain      String
  kind            String
  heading         String
  mode            String @default("hybrid")
  enabled         Boolean @default(false)
  maxItems        Int @default(4)
  pinnedIds       Json
  excludedTags    Json
  ruleGroups      Json
  // Discount publishing is blocked until a Shopify Discount Function is implemented.
  discountType    String @default("none")
  discountAmount  Int    @default(0)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  shop            MerchantShop @relation(fields: [shopDomain], references: [domain], onDelete: Cascade)
  @@unique([shopDomain, kind])
  @@index([shopDomain, enabled])
}

 
// Independent rule sets within each recommendation block type.
// Existing RecommendationBlock records remain in place as migration fallbacks.
model RecommendationRuleSet {
  id               String       @id @default(cuid())
  shopDomain       String
  shop             MerchantShop @relation(fields: [shopDomain], references: [domain], onDelete: Cascade)
  legacyBlockId    String?      @unique
  kind             String
  name             String
  heading          String
  enabled          Boolean      @default(false)
  archived         Boolean      @default(false)
  priority         Int          @default(50)
  sourceMatch      String       @default("all") // all, products, rules
  sourceProductIds Json         @default("[]")
  sourceRules      Json         @default("[]")
  sourceLogic      String       @default("AND")
  selectionMode    String       @default("hybrid") // ai (heuristic), manual, hybrid
  pinnedIds        Json         @default("[]")
  targetRules      Json         @default("[]")
  targetLogic      String       @default("AND")
  excludeTags      Json         @default("[]")
  excludedProductIds Json       @default("[]")
  excludeRules     Json         @default("[]")
  excludeLogic     String       @default("OR")  // Combine exclusion groups
  fallbackMode     String       @default("next") // next matching set, or stop
  bundleDiscountPercent Int     @default(0) // Preview only; Functions activation is separate
  maxItems         Int          @default(3)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([shopDomain, kind, enabled, priority])
  @@index([shopDomain, kind, priority])
}

model RecommendationDesign {
  id          String   @id @default(cuid())
  shopDomain  String
  kind        String
  settings    Json     @default("{}")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  shop        MerchantShop @relation(fields: [shopDomain], references: [domain], onDelete: Cascade)
  @@unique([shopDomain, kind])
  @@index([shopDomain])
}
